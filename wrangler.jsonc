{
  // Cloudflare-Konfiguration: Seiten (Ordner public/) + Workshop-Dienst mit Speicher
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kbs-ki-workshop",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // Im Dashboard gesetzte Variablen (z. B. LEHRER_PIN) beim Veröffentlichen nicht löschen
  "keep_vars": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSHOP", "class_name": "Workshop" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workshop"] }]
}
